          <!-- Minor ticks -->
          <line x1="94" y1="122" x2="92" y2="126" stroke="#06B6D4" stroke-width="1" opacity="0.4"/>
          <line x1="109" y1="136" x2="105" y2="138" stroke="#06B6D4" stroke-width="1" opacity="0.4"/>
